{
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/:path*",
      "destination": "/client/dist/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "/client/dist/favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "/client/dist/icons.svg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/client/dist/favicon.ico"
    },
    {
      "source": "/:path*",
      "destination": "/client/dist/index.html"
    }
  ]
}
